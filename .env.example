# Template de variáveis de ambiente. Nunca commitar um .env real (ver .gitignore).
# Campos sem valor aqui não têm default: a aplicação falha ao subir sem eles.

# "development" | "staging" | "production".
ENVIRONMENT=development
LOG_LEVEL=INFO

# Credencial ADMINISTRATIVA do cluster (Alembic, backup/restore), nunca usada
# por API/Worker em runtime. Troque por um valor forte fora do ambiente local.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mpi
# 5433, não 5432: evita conflito com uma instalação nativa do Postgres no host.
POSTGRES_PORT=5433

# Role de runtime (privilégio mínimo) usada por API e Worker, nunca POSTGRES_USER.
# Gere uma senha forte e rode scripts/setup_postgres_app_role.py para criá-la.
POSTGRES_APP_USER=mpi_app
POSTGRES_APP_PASSWORD=

# Porta precisa bater com POSTGRES_PORT acima.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mpi

# Token compartilhado entre o Moodle e esta API. Gere um valor forte por ambiente.
SERVICE_TOKEN=

# Object Storage (Supabase Storage) usado pelo módulo Material Didático.
STORAGE_URL=https://SEU_PROJETO.supabase.co
STORAGE_SERVICE_KEY=
STORAGE_BUCKET_MATERIAIS=materiais-didaticos
# Limite de tamanho de upload em POST /materiais, em bytes.
MATERIAL_TAMANHO_MAXIMO_BYTES=10485760
# Teto do corpo das demais requisições (JSON), aplicado antes do parse (máx. 10485760).
CORPO_JSON_TAMANHO_MAXIMO_BYTES=1048576
# Limites do pipeline sobre PDFs: páginas por material (1 a 1000) e pixels por imagem extraída.
PDF_PAGINAS_MAXIMAS=100
PDF_PIXELS_MAXIMOS_POR_IMAGEM=25000000
# Expiração da URL assinada de leitura do Material Personalizado, em segundos.
URL_LEITURA_EXPIRACAO_SEGUNDOS=3600

# Gemini: geração de descricao_llm do Perfil e reescrita pedagógica do Pipeline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SEGUNDOS=5.0
# Retry nativo do SDK (backoff exponencial + jitter). GEMINI_RETRY_TENTATIVAS
# inclui a chamada original (3 = original + até 2 retentativas).
GEMINI_RETRY_TENTATIVAS=3
GEMINI_RETRY_ATRASO_INICIAL_SEGUNDOS=1.0
GEMINI_RETRY_ATRASO_MAXIMO_SEGUNDOS=8.0
GEMINI_RETRY_JITTER_SEGUNDOS=1.0
# Orçamento total da chamada pelo Worker, incluindo os retries acima.
GEMINI_TIMEOUT_TOTAL_SEGUNDOS=45.0
# Reescrita curta/incompleta: chamadas extras permitidas (0 desliga) e proporção mínima da resposta
# em relação ao tamanho do original. Só o Worker usa.
GEMINI_REESCRITA_COMPLEMENTO_TENTATIVAS=1
GEMINI_REESCRITA_PROPORCAO_MINIMA=0.8
# Anexar ao final as imagens do PDF de origem? Padrão false: elas não substituem as ilustrações geradas.
PDF_ANEXAR_IMAGENS_ORIGINAIS=false

# Limites das etapas locais do Worker (sem rede). O pior caso de um job precisa caber em
# WORKER_PRAZO_MAXIMO_JOB_SEGUNDOS; PDFs grandes (~30 páginas) pedem extração de 90 s.
PIPELINE_TIMEOUT_EXTRACAO_SEGUNDOS=30.0
PIPELINE_TIMEOUT_PDF_SEGUNDOS=60.0

# Imagens geradas por IA: DESLIGADO por padrão. Ligar exige as variáveis CLOUDFLARE_* mais abaixo
# (o único provedor suportado é a Cloudflare Workers AI). Nenhum modelo é presumido.
IMAGENS_GERADAS_HABILITADAS=false
IMAGENS_PROVEDOR=cloudflare
# Teto de uma imagem, com repetição (máx. 600); não pode ser menor que
# CLOUDFLARE_IMAGE_TIMEOUT_SEGUNDOS.
IMAGENS_TIMEOUT_TOTAL_SEGUNDOS=120.0
# Orçamento compartilhado por todas as imagens de um material (10 a 600); não reinicia por imagem.
IMAGENS_ORCAMENTO_TOTAL_SEGUNDOS=150.0
# Teto de imagens geradas por material (1 a 5); controla custo.
IMAGENS_MAX_POR_MATERIAL=1

# Cloudflare Workers AI, só exigida com IMAGENS_GERADAS_HABILITADAS=true. O plano gratuito
# tem 10.000 Neurons por dia; o token precisa só de "Workers AI: Read" e "Workers AI: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Ex.: @cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_MODEL=
# Passos de difusão (1 a 8); mais passos, mais Neurons por imagem.
CLOUDFLARE_IMAGE_STEPS=4
# Tempo-limite de uma tentativa (máx. 300); o teto de uma imagem é IMAGENS_TIMEOUT_TOTAL_SEGUNDOS.
CLOUDFLARE_IMAGE_TIMEOUT_SEGUNDOS=60.0

# Worker: consumidor da fila_processamento.
# Intervalo entre tentativas de claim quando a fila está vazia.
WORKER_INTERVALO_POLLING_SEGUNDOS=5.0
# Idade máxima de um Processamento em_processamento antes de voltar a pendente.
WORKER_IDADE_MAXIMA_PRESOS_SEGUNDOS=600.0
# Prazo máximo de um job (deve ser menor que o valor acima) e tentativas antes de ir para erro.
WORKER_PRAZO_MAXIMO_JOB_SEGUNDOS=420.0
WORKER_TENTATIVAS_MAXIMAS=3
# Falha transitória do Gemini (503, 429, timeout): o job volta à fila e espera base*2^(n-1) s
# (teto abaixo, jitter só reduz). Pior caso com 3 reivindicações: 30 s + 60 s de espera.
WORKER_REPETICAO_ATRASO_BASE_SEGUNDOS=30.0
WORKER_REPETICAO_ATRASO_MAXIMO_SEGUNDOS=300.0

# Rate limiting por SERVICE_TOKEN, em memória de processo único (ver
# presentation/api/rate_limit.py para a limitação com múltiplas réplicas).
RATE_LIMIT_PROCESSAMENTOS_POR_MINUTO=10
RATE_LIMIT_MATERIAIS_POR_MINUTO=20
RATE_LIMIT_PERFIS_POR_MINUTO=20

# Origens CORS permitidas, em JSON. Vazia em staging/production fecha tudo (fail-closed).
# Exemplo: CORS_ORIGINS_PERMITIDAS=["https://moodle.ufma.br"]
CORS_ORIGINS_PERMITIDAS=[]
