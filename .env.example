# Template de variáveis de ambiente — nunca commitar um .env real (ver .gitignore).
# Todo campo abaixo corresponde 1:1 a um campo de Settings
# (src/infrastructure/config/settings.py); campos sem valor aqui não têm
# default e a aplicação (API ou Worker) falha ao subir sem eles.

# Ambiente do processo e nível de log (Settings.environment, Settings.log_level).
# "development" | "staging" | "production". Tem default — só precisa mudar
# fora do ambiente local.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Lido tanto pela aplicação (Settings) quanto pelo docker-compose.yml (variáveis
# POSTGRES_*) — um único .env cobre os dois, evitando declarar a porta duas vezes.
#
# POSTGRES_USER/POSTGRES_PASSWORD são a credencial ADMINISTRATIVA do cluster
# (Alembic, backup/restore, manutenção — nunca usada por API/Worker em runtime,
# ver POSTGRES_APP_USER/POSTGRES_APP_PASSWORD abaixo). "postgres"/"postgres" é
# só a convenção de conveniência para desenvolvimento local — NÃO reutilize
# esse par em homologação, produção ou qualquer ambiente acessível por mais
# gente além de quem desenvolve na própria máquina. Antes de subir um ambiente
# compartilhado, troque POSTGRES_PASSWORD por um valor aleatório forte.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mpi
# 5433, não 5432: evita conflito com uma instalação nativa do Postgres no host.
POSTGRES_PORT=5433

# Fase 11 — role de runtime, privilégio mínimo (Documento 4 §13.2): API e Worker
# conectam com esta role dentro do Docker, nunca com POSTGRES_USER (admin, usado só
# por Alembic/backup/restore/manutenção). POSTGRES_APP_USER tem default "mpi_app" se
# omitido (não é segredo). POSTGRES_APP_PASSWORD é obrigatório — gere um valor
# aleatório forte, nunca reaproveite POSTGRES_PASSWORD nem este exemplo. Depois de
# definir aqui, rode `python scripts/setup_postgres_app_role.py` para criar a role no
# Postgres já em execução (ver README, seção "Roles do PostgreSQL").
POSTGRES_APP_USER=mpi_app
POSTGRES_APP_PASSWORD=

# Driver asyncpg explícito na URL: é o que permite ao SQLAlchemy usar a engine
# assíncrona. A porta aqui precisa bater com POSTGRES_PORT acima.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mpi

# Token estático compartilhado entre o Moodle e esta API — gere um valor
# aleatório forte por ambiente, nunca reaproveite este exemplo.
SERVICE_TOKEN=

# Object Storage (Supabase Storage) usado pelo módulo Material Didático.
STORAGE_URL=https://SEU_PROJETO.supabase.co
STORAGE_SERVICE_KEY=
STORAGE_BUCKET_MATERIAIS=materiais-didaticos
# Limite de tamanho de upload em POST /materiais, em bytes.
MATERIAL_TAMANHO_MAXIMO_BYTES=10485760
# Expiração da URL assinada de leitura do Material Personalizado (Fase 8),
# em segundos.
URL_LEITURA_EXPIRACAO_SEGUNDOS=3600

# Gemini (geração de descricao_llm do módulo Perfil de Aprendizagem e reescrita
# pedagógica do Pipeline de Personalização — Fase 7).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SEGUNDOS=5.0
# Resiliência (Fase 8 Task 6) — retry nativo do SDK google-genai via
# HttpRetryOptions, com backoff exponencial e jitter. GEMINI_RETRY_TENTATIVAS
# inclui a chamada original (3 = original + até 2 retentativas).
GEMINI_RETRY_TENTATIVAS=3
GEMINI_RETRY_ATRASO_INICIAL_SEGUNDOS=1.0
GEMINI_RETRY_ATRASO_MAXIMO_SEGUNDOS=8.0
GEMINI_RETRY_JITTER_SEGUNDOS=1.0
# Orçamento total de uma chamada ao Gemini pelo Worker, incluindo as
# tentativas de retry acima (o caminho síncrono do Perfil continua limitado a
# GEMINI_TIMEOUT_SEGUNDOS).
GEMINI_TIMEOUT_TOTAL_SEGUNDOS=45.0

# Worker (Fase 7) — consumidor da fila_processamento.
# Intervalo entre tentativas de claim quando a fila está vazia.
WORKER_INTERVALO_POLLING_SEGUNDOS=5.0
# Idade máxima de um Processamento em_processamento antes de ser considerado
# preso e devolvido para pendente — na inicialização do Worker e, desde a
# Fase 7 (hardening), também periodicamente durante o loop contínuo.
WORKER_IDADE_MAXIMA_PRESOS_SEGUNDOS=600.0

# Rate limiting (Fase 9 Task 1, Documento 4 §13.4) — por SERVICE_TOKEN, em
# memória de processo único (ver presentation/api/rate_limit.py para a
# limitação conhecida se a API vier a rodar com múltiplas réplicas).
RATE_LIMIT_PROCESSAMENTOS_POR_MINUTO=10
RATE_LIMIT_MATERIAIS_POR_MINUTO=20

# CORS (Fase 9 Task 3, Documento 4 §13.5) — lista de origens permitidas, em
# JSON. Vazia por padrão: em development isso ativa os defaults locais
# (http://localhost:3000 e http://localhost:8000, ver Settings); em
# staging/production, vazia significa fechado para qualquer origem de
# navegador (fail-closed) até o domínio real do Moodle da UFMA ser definido
# aqui — nunca um valor presumido pelo código.
# Exemplo em produção: CORS_ORIGINS_PERMITIDAS=["https://moodle.ufma.br"]
CORS_ORIGINS_PERMITIDAS=[]
